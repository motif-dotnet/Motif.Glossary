@namespace Motif.Glossary.App
@implements IDisposable
@inject MotifGlossaryApplication App
@inject Browser Browser

<PageTitle>@PageTitle</PageTitle>

@if (started)
{
<div class="app @(dragDepth > 0 ? "dragging" : "")" @onclick="CloseMenus"
     @ondragenter="DragEnter" @ondragleave="DragLeave" @ondragover:preventDefault="true" @ondrop="Drop" @ondrop:preventDefault="true">
    <header class="appbar">
        <ToolSwitcher Current="glossary" Repo="@App.Source?.Repo?.ToString()" Open="@(menu == "tools")" OnToggle="@(() => Toggle("tools"))" />

        @if (App.Source is { } source)
        {
            <div class="vsep wide"></div>
            <span class="pill" title="@SourceTitle(source)">@SourceIcon(source.Kind)<span class="text">@source.Name</span>@if (source.SketchFileName is not null) {<span class="long"> · with sketch file</span>}</span>
        }

        <div class="spacer"></div>

        @if (App.Review is not null)
        {
            <button class="cmd" title="Back to the four ways in" @onclick="StartAgain">@Icons.Back<span class="wide">Start again</span></button>
            <div class="vsep"></div>
        }
        <button class="cmd" title="Open a glossary.md, with its sketch file if you like" @onclick="OpenFiles">@Icons.Open<span class="wide">Open</span></button>
        <button class="cmd" title="Paste a glossary's Markdown" @onclick="ShowPaste">@Icons.Paste<span class="wide">Paste</span></button>
        <button class="cmd" title="Review a public GitHub repo's glossary" @onclick="ShowRepo">@Icons.Repo<span class="wide">Repo</span></button>
        <button class="cmd" title="Motif Sketch's glossary, with its sketch file" @onclick="OpenExample">@Icons.Example<span class="wide">Example</span></button>
        <div class="vsep"></div>
        <ThemeMenu Theme="@theme" ThemeChanged="SetTheme" Open="@(menu == "theme")" OnToggle="@(() => Toggle("theme"))" />
        <button class="cmd icon" title="Help" @onclick="ToggleHelp" @onclick:stopPropagation="true">@SuiteIcons.Help</button>
    </header>

    @if (App.Loading)
    {
        <div class="progress" role="status" aria-label="Reading the repo"></div>
    }
    @if (App.SketchFileProblem is { } sketchProblem)
    {
        <div class="banner"><span>@sketchProblem</span></div>
    }

    <main class="scroll">
        @if (App.Review is { } review)
        {
            <CascadingValue Value="links" IsFixed="false">
                <ReviewView Review="review" Groups="App.Groups" Source="App.Source" ProposedOnly="App.ProposedOnly"
                            ProposedOnlyChanged="ShowProposedOnly" RepoLink="@RepoLinkUrl" CopyRepoLink="CopyRepoLink" Copied="copied"
                            ScrollToGroup="ScrollToGroup" />
            </CascadingValue>
        }
        else if (!App.Loading)
        {
            <section class="start">
                <h1>Review a project's glossary</h1>
                <p class="lead">Every term at a glance, grouped by kind, with its Avoid words, status, In code and sketch ids. Proposed terms are picked out, and gentle notes point to anything that doesn't follow the <a href="https://github.com/motif-dotnet/.github/blob/main/design/glossary.md" target="_blank" rel="noopener">glossary format</a> or no longer matches the sketch.</p>
                <div class="ways">
                    <button class="way" @onclick="OpenFiles">
                        @Icons.Open
                        <b>Open or drop a file</b>
                        <span>A <code>glossary.md</code>, and the <code>sketch.motifsketch.json</code> beside it if there is one. Drop them anywhere on the page.</span>
                    </button>
                    <button class="way" @onclick="ShowPaste">
                        @Icons.Paste
                        <b>Paste Markdown</b>
                        <span>Paste a glossary straight from an editor or a pull request.</span>
                    </button>
                    <div class="way repo">
                        @Icons.Repo
                        <b>A public GitHub repo</b>
                        <span>Reads <code>motif/glossary.md</code> from the default branch, and its sketch file if it has one.</span>
                        <form class="repo-form" @onsubmit="SubmitRepo" @onsubmit:preventDefault="true">
                            <input id="start-repo" placeholder="owner/name" aria-label="GitHub repo, as owner/name" @bind="repoText" @bind:event="oninput" spellcheck="false" autocapitalize="off" />
                            <button class="primary" type="submit" disabled="@(string.IsNullOrWhiteSpace(repoText))">Review</button>
                        </form>
                    </div>
                    <button class="way" @onclick="OpenExample">
                        @Icons.Example
                        <b>The Example</b>
                        <span>Motif Sketch's own glossary, with its sketch file.</span>
                    </button>
                </div>
                <p class="muted small">Everything happens in this browser: nothing is uploaded, and there's no sign-in. Part of <a href="https://github.com/motif-dotnet" target="_blank" rel="noopener">Motif.NET</a>.</p>
            </section>
        }
    </main>

    @if (dragDepth > 0)
    {
        <div class="drop-overlay" aria-hidden="true"><div>Drop a <code>glossary.md</code>, with its sketch file if you like</div></div>
    }

    @if (dialog == "paste")
    {
        <div class="scrim" @onclick="CloseDialog">
            <div class="card dialog wide-dialog" role="dialog" aria-label="Paste a glossary" @onclick:stopPropagation="true">
                <header><div class="t"><b>Paste a glossary</b><span>The Markdown of a <code>motif/glossary.md</code></span></div><button class="x" title="Close" @onclick="CloseDialog">@SuiteIcons.Close</button></header>
                <div class="body">
                    <textarea id="paste-box" class="paste-box" @bind="pasteText" @bind:event="oninput" spellcheck="false" placeholder="# Glossary&#10;&#10;## Term&#10;&#10;What it means.&#10;&#10;- **Kind:** domain concept"></textarea>
                    <div class="row end"><button class="ghost" @onclick="CloseDialog">Cancel</button><button class="primary" disabled="@string.IsNullOrWhiteSpace(pasteText)" @onclick="SubmitPaste">Review</button></div>
                </div>
            </div>
        </div>
    }
    @if (dialog == "repo")
    {
        <div class="scrim" @onclick="CloseDialog">
            <div class="card dialog" role="dialog" aria-label="Review a GitHub repo" @onclick:stopPropagation="true">
                <header><div class="t"><b>Review a GitHub repo</b><span>A public repo with a <code>motif/glossary.md</code></span></div><button class="x" title="Close" @onclick="CloseDialog">@SuiteIcons.Close</button></header>
                <div class="body">
                    <form @onsubmit="SubmitRepo" @onsubmit:preventDefault="true">
                        <div class="field"><label for="repo-box">Repo</label><input id="repo-box" placeholder="owner/name" @bind="repoText" @bind:event="oninput" spellcheck="false" autocapitalize="off" /></div>
                        <p class="help">Such as <button type="button" class="linkish" @onclick="@(() => repoText = "motif-dotnet/Motif.Sketch")">motif-dotnet/Motif.Sketch</button>. A github.com address works too.</p>
                        <div class="row end"><button type="button" class="ghost" @onclick="CloseDialog">Cancel</button><button type="submit" class="primary" disabled="@string.IsNullOrWhiteSpace(repoText)">Review</button></div>
                    </form>
                </div>
            </div>
        </div>
    }

    @if (helpOpen)
    {
        <HelpDialog Current="glossary" OnClose="@(() => helpOpen = false)">
            <h4>Ways in</h4>
            <ul>
                <li><b>Open</b> or drop a <code>glossary.md</code>, with the <code>sketch.motifsketch.json</code> beside it if there is one.</li>
                <li><b>Paste</b> a glossary's Markdown, straight from an editor or a pull request.</li>
                <li><b>Repo</b> reads <code>motif/glossary.md</code> from a public GitHub repo's default branch, and its sketch file if it has one. The address then links straight to the review.</li>
                <li><b>Example</b> is Motif Sketch's own glossary, with its sketch file.</li>
            </ul>
            <h4>The review</h4>
            <ul>
                <li>Terms are grouped by kind. The chips under the title jump to a group.</li>
                <li><b>Proposed</b> terms are picked out in orange. <b>Proposed only</b> hides the rest.</li>
                <li>Notes point to anything that doesn't follow the <a href="https://github.com/motif-dotnet/.github/blob/main/design/glossary.md" target="_blank" rel="noopener">glossary format</a>, or no longer matches the sketch. They never block.</li>
                <li>With a sketch file, Sketch ids show the element or port's name, and sketch items with no term are listed at the end.</li>
            </ul>
            <p class="help">Everything happens in this browser: nothing is uploaded, and there's no sign-in. The glossary is read-only here; change it in the file.</p>
        </HelpDialog>
    }

    <ToastList Toaster="Toaster" />
</div>
}
